  'kyc-personal':    'screen-kyc-personal',
  'kyc-identity':    'screen-kyc-identity',
  'kyc-verify':      'screen-kyc-verify',
  'signup-otp':      'screen-signup-otp',
  'create-passcode': 'screen-create-passcode',
  'home':            'screen-home',
};

const darkScreens = ['splash', 'campaign'];

function showScreen(id) {
  // Hide all
  document.querySelectorAll('.screen').forEach(s => {
    s.classList.remove('active');
    s.style.animation = '';
  });

  // Show target
  const targetId = screens[id];
  const target = document.getElementById(targetId);
  if (!target) return;
  target.classList.add('active');
  target.style.animation = 'screenEnter 0.3s cubic-bezier(0.16,1,0.3,1) both';

  // Phone frame dark mode
  const frame = document.getElementById('phone-frame');
  if (darkScreens.includes(id)) {
    frame.classList.add('dark-bg');
  } else {
    frame.classList.remove('dark-bg');
  }

  // Nav buttons
  document.querySelectorAll('.screen-nav-btn').forEach(b => b.classList.remove('active'));
  const navBtn = document.getElementById('nav-' + id);
  if (navBtn) navBtn.classList.add('active');

  // Screen-specific init
  if (id === 'login-otp') initCountdown('login', 59);
  if (id === 'signup-otp') initCountdown('signup', 60);
  if (id === 'login-passcode') resetPasscode('login');
  if (id === 'create-passcode') resetPasscode('create');
  if (id === 'home') initHomeEntry();
}

// ─── Campaign Countdown Timer ─────────────────────────────────────
(function startCampaignTimer() {
  let sec = 31, min = 44, hrs = 6, days = 18;
  setInterval(() => {
    sec--;
    if (sec < 0) { sec = 59; min--; }
    if (min < 0) { min = 59; hrs--; }
    if (hrs < 0) { hrs = 23; days--; }
    const s = document.getElementById('camp-sec');
    const m = document.getElementById('camp-min');
    const h = document.getElementById('camp-hrs');
    const d = document.getElementById('camp-days');
    if (s) s.textContent = String(sec).padStart(2, '0');
    if (m) m.textContent = String(min).padStart(2, '0');
    if (h) h.textContent = String(hrs).padStart(2, '0');
    if (d) d.textContent = String(days).padStart(2, '0');
  }, 1000);
})();

// ─── OTP Countdown ───────────────────────────────────────────────
const countdownIntervals = {};

function initCountdown(prefix, total) {
  clearInterval(countdownIntervals[prefix]);
  let remaining = total;
  const el = document.getElementById(prefix + '-countdown');
  const resend = document.getElementById(prefix + '-resend');
  if (!el) return;
  if (resend) { resend.classList.add('disabled'); }

  function tick() {
    const m = Math.floor(remaining / 60);
    const s = remaining % 60;
    el.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    if (remaining <= 0) {
      clearInterval(countdownIntervals[prefix]);
      el.textContent = '00:00';
      if (resend) resend.classList.remove('disabled');
    }
    remaining--;
  }
  tick();
  countdownIntervals[prefix] = setInterval(tick, 1000);
}

function resetLoginCountdown() {
  initCountdown('login', 59);
}

// ─── OTP Input Logic ──────────────────────────────────────────────
function initOTP(prefix, count) {
  for (let i = 0; i < count; i++) {
    const cell = document.getElementById(prefix + '-' + i);
    if (!cell) continue;
    cell.addEventListener('input', function(e) {
      const val = e.target.value.replace(/\D/g, '').slice(-1);
      e.target.value = val;
      if (val) {
        e.target.classList.add('filled');
        const next = document.getElementById(prefix + '-' + (i + 1));
        if (next) next.focus();
      } else {
        e.target.classList.remove('filled');
      }
    });
    cell.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace' && !e.target.value) {
        const prev = document.getElementById(prefix + '-' + (i - 1));
        if (prev) { prev.value = ''; prev.classList.remove('filled'); prev.focus(); }
      }
    });
    cell.addEventListener('paste', function(e) {
      e.preventDefault();
      const text = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
      for (let j = 0; j < count && j < text.length; j++) {
        const c = document.getElementById(prefix + '-' + j);
        if (c) { c.value = text[j]; c.classList.add('filled'); }
      }
    });
  }
}

// Initialize OTP inputs
initOTP('otp', 6);
initOTP('sotp', 6);

// ─── Passcode Keypad ─────────────────────────────────────────────
const passcodePins = { login: [], create: [] };
const createStep = { phase: 'create', firstPin: [] };

function resetPasscode(prefix) {
  passcodePins[prefix] = [];
  for (let i = 0; i < 6; i++) {
    const dot = document.getElementById(
      prefix === 'login' ? 'lpc-' + i : 'cpc-' + i
    );
    if (dot) { dot.classList.remove('filled', 'animated'); }
  }
  if (prefix === 'create') {
    createStep.phase = 'create';
    createStep.firstPin = [];
    const title = document.getElementById('create-pc-title');
    const sub = document.getElementById('create-pc-sub');
    if (title) title.textContent = 'Create your passcode';
    if (sub) sub.textContent = 'Choose a 6-digit passcode to secure your account.';
  }
}

function keypadPress(prefix, digit) {
  if (passcodePins[prefix].length >= 6) return;
  passcodePins[prefix].push(digit);
  const idx = passcodePins[prefix].length - 1;
  const dot = document.getElementById(
    prefix === 'login' ? 'lpc-' + idx : 'cpc-' + idx
  );
  if (dot) {
    dot.classList.add('filled', 'animated');
    setTimeout(() => dot.classList.remove('animated'), 300);
  }

  if (passcodePins[prefix].length === 6) {
    setTimeout(() => {
      if (prefix === 'login') {
        // Navigate to home
        showScreen('home');
        passcodePins[prefix] = [];
      } else if (prefix === 'create') {
        handleCreatePasscode();
      }
    }, 400);
  }
}

function keypadDelete(prefix) {
  if (passcodePins[prefix].length === 0) return;
  const idx = passcodePins[prefix].length - 1;
  const dot = document.getElementById(
    prefix === 'login' ? 'lpc-' + idx : 'cpc-' + idx
  );
  if (dot) dot.classList.remove('filled');
  passcodePins[prefix].pop();
}

function handleCreatePasscode() {
  if (createStep.phase === 'create') {
    createStep.firstPin = [...passcodePins.create];
    createStep.phase = 'confirm';
    passcodePins.create = [];
    for (let i = 0; i < 6; i++) {
      const dot = document.getElementById('cpc-' + i);
      if (dot) dot.classList.remove('filled');
    }
    const title = document.getElementById('create-pc-title');
    const sub = document.getElementById('create-pc-sub');
    if (title) title.textContent = 'Confirm your passcode';
    if (sub) sub.textContent = 'Re-enter your 6-digit passcode to confirm.';
  } else if (createStep.phase === 'confirm') {
    const match = createStep.firstPin.join('') === passcodePins.create.join('');
    if (match) {
      showScreen('home');
    } else {
      // Show error shake
      for (let i = 0; i < 6; i++) {
        const dot = document.getElementById('cpc-' + i);
        if (dot) { dot.style.background = '#D64545'; dot.style.borderColor = '#D64545'; }
      }
      setTimeout(() => {
        resetPasscode('create');
        createStep.phase = 'create';
        const title = document.getElementById('create-pc-title');
        const sub = document.getElementById('create-pc-sub');
        if (title) title.textContent = 'Create your passcode';
        if (sub) sub.textContent = 'Passcodes did not match. Please try again.';
      }, 700);
    }
  }
}

function showBiometric() {
  // Simulate biometric auth
  setTimeout(() => showScreen('home'), 600);
}

// ─── Radio Group ──────────────────────────────────────────────────
function selectRadio(el) {
  const group = el.closest('.radio-group');
  if (!group) return;
  group.querySelectorAll('.radio-option').forEach(opt => {
    opt.classList.remove('selected');
    opt.setAttribute('aria-checked', 'false');
  });
  el.classList.add('selected');
  el.setAttribute('aria-checked', 'true');
}

// ─── ID Type ──────────────────────────────────────────────────────
function selectIdType(el) {
  const grid = el.closest('.id-type-grid');
  if (!grid) return;
  grid.querySelectorAll('.id-type-card').forEach(card => {
    card.classList.remove('selected');
    card.setAttribute('aria-checked', 'false');
  });
  el.classList.add('selected');
  el.setAttribute('aria-checked', 'true');
}

// ─── Document Upload Simulation ───────────────────────────────────
function simulateUpload(side) {
  const el = document.getElementById('doc-' + side);
  if (!el) return;
  el.style.borderColor = 'rgba(200,169,120,0.6)';
  el.innerHTML = `
    <div class="doc-frame-icon" style="background:rgba(45,106,79,0.15);">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M5 10l4 4 6-7" stroke="#2D6A4F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="doc-frame-label" style="color:rgba(200,169,120,0.8);">Document uploaded</div>
  `;
}

// ─── Tabs Logic (History / What's Up) ───────────────────────────────
function switchHomeTab(tab) {
  const tHist = document.getElementById('tab-history');
  const tWhat = document.getElementById('tab-whatsup');
  const cHist = document.getElementById('content-history');
  const cWhat = document.getElementById('content-whatsup');
  
  if (tab === 'history') {
    tHist.style.fontWeight = '600';
    tHist.style.color = 'var(--c-black)';
    tHist.style.borderBottomColor = 'var(--c-primary)';
    
    tWhat.style.fontWeight = '500';
    tWhat.style.color = 'var(--c-neutral-400)';
    tWhat.style.borderBottomColor = 'transparent';
    
    cHist.style.display = 'block';
    cWhat.style.display = 'none';
  } else {
    tWhat.style.fontWeight = '600';
    tWhat.style.color = 'var(--c-black)';
    tWhat.style.borderBottomColor = 'var(--c-primary)';
    
    tHist.style.fontWeight = '500';
    tHist.style.color = 'var(--c-neutral-400)';
    tHist.style.borderBottomColor = 'transparent';
    
    cWhat.style.display = 'block';
    cHist.style.display = 'none';
  }
}

// ─── Home Entry Animation ─────────────────────────────────────────
function initHomeEntry() {
  // Subtle entrance for balance card
}

// ─── Keyboard accessibility: Enter on back-btn ────────────────────
document.addEventListener('keydown', function(e) {
  if (e.key === 'Enter' && e.target.classList.contains('back-btn')) {
    e.target.click();
  }
});

// ─── Init ─────────────────────────────────────────────────────────
// Splash screen auto-transition after 3 seconds in demo mode
// (user can also click manually)
window.addEventListener('load', function() {
  // Start on splash, already set
});
</script>

